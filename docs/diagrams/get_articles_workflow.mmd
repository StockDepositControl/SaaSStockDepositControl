sequenceDiagram
    autonumber
    
    actor Client as Client (HTTP)
    participant API as FastAPI Router (api/v1/articles)
    participant WorkSvc as WorkSessionService
    participant AppSvc as ArticleCatalogOrchestrator
    participant ArticleSvc as ArticleSearchService
    participant StockSvc as StockLookupService
    participant WorkPort as WorkSessionRepositoryPort (ABC)
    participant ArticlePort as ArticleRepositoryPort (ABC)
    participant AuditPort as AuditRepositoryPort (ABC)
    participant StockPort as StockRepositoryPort (ABC)
    participant DB_Articles as db_articles (MariaDB)
    participant DB_Analytics as db_analytics (MariaDB)

    Client->>API: GET /api/v1/articles?page=1&limit=50&id_deposito=1
    API->>API: Extract role and claims (tenant_id, branch_id)
    
    API->>WorkSvc: get_or_create_active_session(tenant_id, branch_id)
    WorkSvc->>WorkPort: get_active_session(tenant_id, branch_id)
    WorkPort->>DB_Analytics: SELECT * FROM work_sessions WHERE branch_id = :branch_id AND status = 'ACTIVE'
    DB_Analytics-->>WorkPort: Active session record
    WorkPort-->>WorkSvc: Active session domain object
    WorkSvc-->>API: Returns active_session_id

    API->>AppSvc: get_enriched_catalog(page, limit, filters, deposit_id, active_session_id)
    
    AppSvc->>ArticleSvc: list_articles(page, limit, filters)
    ArticleSvc->>ArticlePort: list_articles(page, limit, filters)
    
    ArticlePort->>DB_Articles: SELECT COUNT(id_articulo) FROM articulos WHERE ...
    DB_Articles-->>ArticlePort: Total count
    
    ArticlePort->>DB_Articles: SELECT a.*, m.des_marca, g.des_grupo, f.des_familia FROM articulos a JOIN marca m JOIN grupo g JOIN familia f WHERE ... ORDER BY a.id_articulo OFFSET 0 LIMIT 50
    DB_Articles-->>ArticlePort: 50 ORM Article Entities
    
    ArticlePort-->>ArticleSvc: (List of Articles, total_count)
    ArticleSvc-->>AppSvc: (List of Articles, total_count)
    
    AppSvc->>StockSvc: get_effective_stocks_batch(article_ids, deposit_id, active_session_id)
    
    StockSvc->>AuditPort: get_latest_audits_for_articles(session_id, article_ids)
    AuditPort->>DB_Analytics: SELECT article_code, audit_quantity FROM (SELECT article_code, audit_quantity, ROW_NUMBER() OVER (PARTITION BY article_code ORDER BY scan_timestamp DESC) as rn FROM audit_records WHERE session_id = :session_id AND article_code IN ('ART1', 'ART2', ...)) t WHERE rn = 1
    DB_Analytics-->>AuditPort: Audited records
    AuditPort-->>StockSvc: Map {art_id: audit_quantity}

    StockSvc->>StockPort: get_stock_positions_batch(tenant_id, branch_id, deposit_id, remaining_article_ids)
    StockPort->>DB_Articles: SELECT id_articulo, stock_real FROM stock_deposito WHERE id_empresa = :tenant_id AND id_sucursal = :branch_id AND id_deposito = :deposit_id AND id_articulo IN ('ART2', 'ART4', ...)
    DB_Articles-->>StockPort: Base stock records
    StockPort-->>StockSvc: Map {art_id: stock_real}

    StockSvc-->>AppSvc: Combined effective stock map {art_id: stock_real}
    
    AppSvc->>AppSvc: Assign stock_real to each Article entity
    AppSvc-->>API: (List of Enriched Articles, total_count)
    
    API->>API: Map DTOs based on role (ArticuloAdminOut vs ArticuloPublicOut)
    API-->>Client: HTTP 200 OK (Paginated JSON with items, total, page, limit, pages)