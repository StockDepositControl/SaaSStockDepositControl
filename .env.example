# ─── MariaDB Container Configuration ───
MARIADB_ROOT_PASSWORD=changeme_root_password
MARIADB_APP_PASSWORD=changeme_app_password
MARIADB_PORT=3306

# ─── Backend Application Database Connection ───
DB_USER=app_user
DB_PASSWORD=changeme_app_password
DB_HOST=localhost
DB_PORT=3306

DB_NAME_ARTICLES=db_articles
DB_NAME_USERS=db_users
DB_NAME_ANALYTICS=db_analytics

# Full connection URLs (alternative to individual variables)
DATABASE_URL=mysql+aiomysql://app_user:changeme_app_password@localhost:3306/db_articles
USERS_DATABASE_URL=mysql+aiomysql://app_user:changeme_app_password@localhost:3306/db_users
ANALYTICS_DATABASE_URL=mysql+aiomysql://app_user:changeme_app_password@localhost:3306/db_analytics

# ─── Application Settings ───
SECRET_KEY=changeme_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
