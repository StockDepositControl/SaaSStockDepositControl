# Copy to .env and fill in. Never commit .env.
# Same images everywhere: only this file changes between targets.
#
# Profiles (run from the repo root):
#   default    docker compose up -d                       proxy + backend + web, EXTERNAL database
#   with-db    docker compose --profile with-db up -d     adds MariaDB 10.11 (bound to 127.0.0.1 only)
#   demo       docker compose --profile demo up -d        adds a one-shot seed (sample data)
#   tunnel     docker compose --profile tunnel up -d      adds Cloudflare Tunnel (no open ports)
# Profiles combine, e.g. `--profile with-db --profile demo`.
# Local development with hot reload: add `-f docker-compose.yml -f docker-compose.dev.yml`.

# ─── Images ───
# Compose pre-sets COMPOSE_PROJECT_NAME from the directory name; keep it here
# so image names resolve to ghcr.io/<GHCR_OWNER>/saas-stock-{backend,web}.
COMPOSE_PROJECT_NAME=saas-stock
GHCR_OWNER=stockdeposit
# latest | edge | vX.Y.Z | sha-<short>. Updated by the deploy script on update/rollback.
IMAGE_TAG=latest

# ─── Ingress (Caddy) ───
# :8080              plain HTTP (local, LAN, Cloudflare Tunnel). No certificates.
# stock.example.com  public domain: automatic HTTPS (needs ports 80/443 open and DNS pointing here).
# HTTPS is required for the browser camera barcode scanner outside localhost.
SERVER_NAME=:8080
# Optional ACME contact, as a FULL Caddy directive. Leave commented to omit it.
# ACME_EMAIL_OPTION=email ops@example.com
# Host port for plain HTTP when SERVER_NAME=:8080.
HTTP_PORT=8080

# ─── Application ───
# production enforces a strong SECRET_KEY at startup (the backend refuses to start otherwise).
ENVIRONMENT=production
# Required, at least 32 characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Apply Alembic migrations on container start (only one backend replica should do it).
RUN_MIGRATIONS=true
# Per-database switches (default true). RUN_MIGRATIONS=false skips all three regardless.
# Set RUN_MIGRATIONS_ARTICLES=false when db_articles is an external read-only pharmacy
# database: Alembic must never touch its schema.
RUN_MIGRATIONS_ARTICLES=true
RUN_MIGRATIONS_USERS=true
RUN_MIGRATIONS_ANALYTICS=true
UVICORN_WORKERS=2
# Used when the backend runs outside Compose. Behind Caddy everything is single-origin.
CORS_ORIGINS=http://localhost:8080

# ─── Database connection (backend) ───
# with-db profile: DB_HOST=mariadb and DB_PASSWORD equal to MARIADB_APP_PASSWORD.
# External database: set DB_HOST to its address (host.docker.internal for a DB on this host).
DB_HOST=mariadb
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=
DB_NAME_ARTICLES=db_articles
DB_NAME_USERS=db_users
DB_NAME_ANALYTICS=db_analytics

# Database TLS: disable (private network / compose network) | require (encrypt, no cert check)
# | verify-ca (validate the server certificate against DB_SSL_CA; hostname is not checked).
# Use require or verify-ca for any database reached over a public IP.
DB_SSL_MODE=disable
# Path INSIDE the container to the CA bundle (mount it into the backend service).
# DB_SSL_CA=/certs/ca.pem

# Full URLs override the DB_* variables above. Precedence per database:
# <TARGET>_DATABASE_URL -> DATABASE_URL (database name swapped) -> DB_*. Keep commented unless needed.
# Encode special characters in passwords (e.g. @ -> %40).
# DATABASE_URL=mysql+aiomysql://app_user:password@db.example.com:3306/db_articles
# ARTICLES_DATABASE_URL=
# USERS_DATABASE_URL=
# ANALYTICS_DATABASE_URL=

# ─── MariaDB container (with-db profile only) ───
MARIADB_ROOT_PASSWORD=
MARIADB_APP_PASSWORD=
# Published on 127.0.0.1 only, never on 0.0.0.0.
MARIADB_PORT=3306

# ─── Cloudflare Tunnel (tunnel profile only) ───
# Token from the Cloudflare Zero Trust dashboard. Point the public hostname at http://proxy:8080
# and keep SERVER_NAME=:8080.
CLOUDFLARE_TUNNEL_TOKEN=
